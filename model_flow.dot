
digraph {
  graph [layout=neato, splines=true, overlap=false, fontname="Helvetica", bgcolor="transparent"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=16, margin="0.18,0.09"];
  edge  [color="#6b7785", arrowsize=0.7, fontname="Helvetica", fontsize=14];

  init [pos="-0.6,0!", fillcolor="#e3ecf7", color="#4c9be8",
        label="Initial conditions (at birth)\n\nFixed: CHD severity, sex, race/ethnicity,\nparent education, insurance, family poverty\n\nJoint draws:\ndevelopmental delay, intellectual disability;\never diagnosed with anxiety, depression,\nor behavioral problems, and at what age\n(revealed when the child reaches that age)"];
  center [pos="8.60,0.00!", shape=plaintext, style="", fontsize=16, fontcolor="#4a5563",
          label="Each year of age\nchildhood outcomes 1-17\nmortality and costs through 24"];
  mort [pos="8.60,3.40!", label="1. Mortality\nlife table x severity risk", fillcolor="#f7e6e4", color="#c8433b"];
  hlth [pos="12.06,2.12!", label="2. Health\nspecial health care needs;\nconditions revealed at onset age", fillcolor="#f4f6f8", color="#9aa5b1"];
  util [pos="12.91,-0.76!", label="3. Health care use\nER visits, specialist visits", fillcolor="#f4f6f8", color="#9aa5b1"];
  par [pos="10.52,-3.06!", label="4. Impacts on parents\nstopped working,\ndifficulty affording essentials", fillcolor="#f4f6f8", color="#9aa5b1"];
  child [pos="6.68,-3.06!", label="5. Additional impacts on child\naccess to care, exercise,\ngrades, school absence", fillcolor="#f4f6f8", color="#9aa5b1"];
  srh [pos="4.29,-0.76!", label="6. Overall health\nself-rated health, QALY weight", fillcolor="#f4f6f8", color="#9aa5b1"];
  cost [pos="5.14,2.12!", label="7. Costs\nclaims models: hospital, ED and\nclinic visits, then payments", fillcolor="#fdf1de", color="#e8a33d"];
  mort -> hlth;
  hlth -> util;
  util -> par;
  par -> child;
  child -> srh;
  srh -> cost;
  cost -> mort [label="  next age", fontsize=14, fontcolor="#6b7785", style=dashed];
  init -> mort [penwidth=1.3];

  link [pos="18.30,2.60!", fillcolor="#e9f3ea", color="#4f9a5a",
        label="Age 25: link to adulthood\n\nEach child alive at 25 is matched to\nPSID adults with a childhood heart\ncondition, by sex and childhood\nself-rated health (children without\nCHD: adults without one)"];
  fam  [pos="18.30,-1.75!", fillcolor="#e9f3ea", color="#4f9a5a",
        label="Ages 25 to death: Future Adult Model\n\nchronic conditions, mortality, work,\nearnings, disability, medical spending,\nquality of life"];
  mort -> link [penwidth=1.3, label="alive at 25\n", fontsize=14, fontcolor="#6b7785"];
  link -> fam [penwidth=1.3];
  kidiv [pos="8.60,-4.30!", shape=plaintext, style="", fontsize=15, fontcolor="#4a5563",
         label="Childhood interventions change the yearly risks above"];
  adiv  [pos="18.30,-3.55!", shape=plaintext, style="", fontsize=15, fontcolor="#4a5563",
         label="Adult interventions change\nrisks in the Future Adult Model"];
}
